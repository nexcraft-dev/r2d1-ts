{
  "name": "@nexcraft-dev/r2d1",
  "version": "0.1.0",
  "description": "Document storage on Cloudflare R2 with rebuildable D1 indexes for Node.js and Workers",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./workers": {
      "types": "./dist/workers/index.d.ts",
      "import": "./dist/workers/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node --test test/live/*.test.mjs",
    "verify:java": "npm run build && node scripts/java-fixtures.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexcraft-dev/r2d1-ts.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
